{
	"name": "site",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"fetch:wasm": "node ./scripts/fetch-wasm.mjs",
		"check:wasm": "node ./scripts/fetch-wasm.mjs --check",
		"pin:mutant": "node ./scripts/pin-mutant.mjs",
		"sync:mutant": "node ./scripts/mutant-sync.mjs",
		"check:sync": "node ./scripts/mutant-sync.mjs --check",
		"check:links": "node ./scripts/check-links.mjs",
		"check:docs:wasm": "node ./scripts/lint-wasm-docs.mjs",
		"predev": "npm run fetch:wasm",
		"prebuild": "npm run fetch:wasm",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "npm run check:sync && npm run check:docs:wasm && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-netlify": "^6.0.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/lunr": "^2.3.7",
		"@types/node": "^26.1.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"fast-glob": "^3.3.3",
		"gray-matter": "^4.0.3",
		"lunr": "^2.3.9",
		"marked": "^18.0.6",
		"plantuml-encoder": "^1.4.0",
		"shiki": "^4.4.3",
		"zod": "^4.4.3"
	},
	"engines": {
		"node": ">=22.12"
	}
}
